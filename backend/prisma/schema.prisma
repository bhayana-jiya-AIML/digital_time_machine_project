generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
    id        Int      @id @default(autoincrement())
    name      String
    email     String   @unique
    password  String
    createdAt DateTime @default(now())

    memories  Memory[]
}

model Memory {
    id          Int      @id @default(autoincrement())
    title       String
    description String
    date        DateTime
    location    String?
    tags        String?
    imageUrl    String?
    createdAt   DateTime @default(now())

    userId      Int
    user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}